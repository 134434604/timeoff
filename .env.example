# Copy to .env.local for local work. Production reads .env.local on the host too.

# Where the app is reached from a browser. Required for real Google sign-in;
# https here also marks cookies Secure.
# On the host: https://timeoff.<your company domain>
PUBLIC_ORIGIN=http://127.0.0.1:5610
PORT=5610
# HOST defaults to 127.0.0.1. Some hosts set PORT themselves.
# On the host only: the web server in front makes every visitor look alike, so the sign-in limit needs X-Forwarded-For.
# TRUST_PROXY=1

# Only people on the roster can sign in. The first sign-in by this address
# becomes the admin and can add everyone else.
BOOTSTRAP_ADMIN_EMAIL=
# Optional: refuse Google accounts outside this domain even before the roster check.
ALLOWED_EMAIL_DOMAIN=

# Google Cloud OAuth client (Web application). Redirect URIs to register:
#   {PUBLIC_ORIGIN}/api/auth/google/callback
#   {PUBLIC_ORIGIN}/api/settings/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email goes out from the admin's Google Workspace account once she connects
# Google in Settings (the same consent as the calendar). Nothing to set here.
# Optional From: the account itself or one of its Workspace "send as" aliases.
MAIL_FROM=
# Optional fallback while Google is not connected for email: an SMTP mailbox (needs MAIL_FROM).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Slack, where staff ask and managers approve (/timeoff). Both set = on.
# From the app made with docs/slack-manifest.yml: Bot User OAuth Token and Signing Secret.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Optional: the App ID (Basic Information). Slack posts carrying another app id are refused; unset, the id auth.test reports is used.
# SLACK_APP_ID=

# Local stand-ins. Never set on a host; the server refuses to start (fixture-guard.mjs).
# ALLOW_FIXTURES=1
# GOOGLE_FIXTURE=1
# MAIL_FIXTURE=1
# CALENDAR_FIXTURE=1
# SLACK_FIXTURE=1
